{
  "name": "mail-grid",
  "productName": "Mail Grid",
  "version": "0.3.2",
  "private": true,
  "author": {
    "name": "Mail Grid contributors"
  },
  "license": "UNLICENSED",
  "description": "A local email workspace for developers",
  "main": "dist-electron/main.js",
  "scripts": {
    "postinstall": "install-electron",
    "start": "node scripts/launch-desktop.cjs --preview",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && npm run build:main && node scripts/launch-desktop.cjs\"",
    "build:engine": "node scripts/build-engine.mjs",
    "build:main": "tsc -p tsconfig.electron.json",
    "build:ui": "vite build",
    "build": "npm run locales:build && npm run build:engine && npm run build:main && npm run build:ui",
    "make": "npm run build && electron-builder --config electron-builder.cjs --publish never",
    "installers": "node scripts/package-installers.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test:engine": "cd engine && go test ./...",
    "test:integration": "python3 tests/integration.py",
    "test:desktop": "node tests/desktop.cjs",
    "test:accounts": "node tests/accounts.cjs",
    "test:credentials": "node tests/credentials.cjs",
    "test:connection": "node tests/connection.cjs",
    "test:mailbox": "node tests/mailbox.cjs",
    "test:sidebar": "node tests/sidebar.cjs",
    "test:preferences": "node tests/preferences.cjs",
    "test:content": "node tests/content-actions.cjs && node tests/notifications.cjs && node tests/system-settings.cjs && node tests/unread-badge.cjs",
    "test:updates": "node tests/updates.cjs",
    "release:build": "npm run build:main && npm run build:ui && electron-builder --config electron-builder.cjs",
    "release:bundle": "node scripts/release-bundle.mjs",
    "release:key": "node scripts/release-key.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "locales:build": "node scripts/build-locales.mjs"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "electron-updater": "6.8.11",
    "lucide-react": "^0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semver": "7.7.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/semver": "7.7.1",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "electron": "^45.0.0",
    "electron-builder": "26.18.0",
    "playwright": "^1.64.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "wait-on": "^9.0.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.4": true,
    "fs-xattr@0.3.1": true,
    "macos-alias@0.2.12": true,
    "fsevents@2.3.3": true
  }
}
